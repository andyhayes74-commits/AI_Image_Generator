{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-image-generator/schemas/client_question.schema.json",
  "title": "Client Question",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "question_id", "job_id", "created_at", "status", "priority", "question", "answer_type"],
  "properties": {
    "schema_version": { "type": "string", "const": "0.2.0" },
    "question_id": { "type": "string", "pattern": "^cq_[A-Za-z0-9_-]+$" },
    "job_id": { "type": "string", "pattern": "^job_[A-Za-z0-9_-]+$" },
    "created_at": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["open", "answered", "cancelled"] },
    "priority": { "type": "string", "enum": ["low", "normal", "high", "blocking"] },
    "question": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "context_summary": { "type": "string", "maxLength": 2000 },
    "answer_type": { "type": "string", "enum": ["free_text", "single_choice", "multiple_choice", "asset_upload"] },
    "options": { "type": "array", "items": { "type": "string", "minLength": 1 }, "default": [] }
  }
}
