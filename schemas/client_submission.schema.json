{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-image-generator.local/schemas/client_submission.schema.json",
  "title": "Client Submission",
  "type": "object",
  "additionalProperties": false,
  "required": ["submission_id", "job_id", "submitted_at", "source", "client_brief", "assets"],
  "properties": {
    "submission_id": { "type": "string", "pattern": "^sub-[A-Za-z0-9_-]+$" },
    "job_id": { "type": "string", "minLength": 1 },
    "submitted_at": { "type": "string", "format": "date-time" },
    "source": {
      "type": "string",
      "enum": ["wordpress_admin", "wordpress_client_portal", "mock_fixture"]
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "client_id": { "type": "string" },
        "display_name": { "type": "string" },
        "email": { "type": "string", "format": "email" }
      }
    },
    "client_brief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "target_object", "desired_scene_change"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "target_object": { "type": "string", "minLength": 1 },
        "desired_scene_change": { "type": "string", "minLength": 1 },
        "constraints": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        },
        "protected_elements": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/asset" }
    },
    "requested_mode": {
      "type": "string",
      "enum": ["mock", "live"],
      "default": "mock"
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "declared_role", "media_type", "uri"],
      "properties": {
        "asset_id": { "type": "string", "minLength": 1 },
        "declared_role": {
          "type": "string",
          "enum": ["scene_image", "object_reference", "object_sketch", "placement_sketch", "annotation", "manual", "style_reference", "unknown"]
        },
        "media_type": {
          "type": "string",
          "enum": ["image/jpeg", "image/png", "image/webp", "application/pdf", "text/plain"]
        },
        "uri": { "type": "string", "minLength": 1 },
        "client_label": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  }
}
