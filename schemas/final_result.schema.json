{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-image-generator/schemas/final_result.schema.json",
  "title": "Final Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "final_result_id", "job_id", "created_at", "status", "versions", "summary"],
  "properties": {
    "schema_version": { "type": "string", "const": "0.2.0" },
    "final_result_id": { "type": "string", "pattern": "^final_[A-Za-z0-9_-]+$" },
    "job_id": { "type": "string", "pattern": "^job_[A-Za-z0-9_-]+$" },
    "created_at": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["approved", "delivered", "needs_rework", "failed"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version_id", "role", "uri", "approved"],
        "properties": {
          "version_id": { "type": "string", "pattern": "^ver_[A-Za-z0-9_-]+$" },
          "role": { "type": "string", "enum": ["primary", "alternate", "preview"] },
          "uri": { "type": "string", "format": "uri" },
          "approved": { "type": "boolean" },
          "notes": { "type": "string", "maxLength": 1000 }
        }
      }
    },
    "validation_id": { "type": "string", "pattern": "^val_[A-Za-z0-9_-]+$" },
    "delivery_notes": { "type": "string", "maxLength": 2000 }
  }
}
